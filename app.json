{
  "expo": {
    "name": "Kabi Delivery",
    "slug": "KabiDeliveryApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "kabideliveryapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.akonizk.kabideliveryapp",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Kabi Delivery utilise votre position pour vous proposer les livreurs à proximité et suivre vos commandes en temps réel.",
        "NSPhotoLibraryUsageDescription": "Kabi Delivery a besoin d'accéder à vos photos pour mettre à jour votre photo de profil.",
        "NSCameraUsageDescription": "Kabi Delivery a besoin de la caméra pour prendre une photo de profil."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#258675",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "app.akonizk.kabideliveryapp",
      "versionCode": 1,
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#258675",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Kabi Delivery utilise votre position pour vous proposer les livreurs à proximité et suivre vos commandes en temps réel.",
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Kabi Delivery a besoin d'accéder à vos photos pour mettre à jour votre photo de profil.",
          "cameraPermission": "Kabi Delivery a besoin de la caméra pour prendre une photo de profil."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#258675",
          "defaultChannel": "default"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "11268ea1-be13-4455-8604-562763abcda2"
      }
    }
  }
}
