{
  "expo": {
    "name": "KabiDeliveryApp",
    "slug": "KabiDeliveryApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/iconn.jpg",
    "scheme": "kabideliveryapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#258675",
        "foregroundImage": "./assets/images/logo.png",
        "backgroundImage": "./assets/images/iconn.jpg",
        "monochromeImage": "./assets/images/logo.png"
      },
      "package": "app.akonizk.kabideliveryapp",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/iconn.jpg"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/iconn.jpg",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#258675",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "11268ea1-be13-4455-8604-562763abcda2"
      }
    }
  }
}
